{
  "app-id": "io.github.scripta.Scripta",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "24.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "scripta",
  "finish-args": [
    "--share=ipc",
    "--socket=x11",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--filesystem=xdg-documents",
    "--filesystem=xdg-download",
    "--filesystem=home"
  ],
  "modules": [
    {
      "name": "scripta",
      "buildsystem": "simple",
      "build-commands": [
        "install -d /app/bin /app/share/applications /app/share/metainfo /app/share/icons/hicolor/scalable/apps",
        "cp -r bundle/* /app/bin/",
        "chmod +x /app/bin/Scripta /app/bin/scripta 2>/dev/null || true",
        "install -D -m 0644 packaging/io.github.scripta.Scripta.desktop /app/share/applications/io.github.scripta.Scripta.desktop",
        "install -D -m 0644 packaging/io.github.scripta.Scripta.metainfo.xml /app/share/metainfo/io.github.scripta.Scripta.metainfo.xml",
        "install -D -m 0644 packaging/icons/io.github.scripta.Scripta.svg /app/share/icons/hicolor/scalable/apps/io.github.scripta.Scripta.svg"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../../"
        }
      ]
    }
  ]
}
