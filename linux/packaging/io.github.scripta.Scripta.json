{
  "app-id": "io.github.scripta.Scripta",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "24.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "scripta",
  "finish-args": [
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--device=dri",
    "--filesystem=host"
  ],
  "modules": [
    {
      "name": "scripta",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/bin",
        "cp -r * /app/bin/",
        "chmod +x /app/bin/scripta"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../../bundle"
        }
      ]
    }
  ]
}
